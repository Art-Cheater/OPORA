# Flask
FLASK_APP=run.py
# На сервере (Docker): production. Для локальной разработки: development
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-me-to-a-random-secret-key

# Database
# Временный локальный режим без PostgreSQL:
# USE_SQLITE=1
# (файл instance/opora.db; схема через: python -m flask init-db)

# PostgreSQL в Docker (Flask и БД на одном компе, сервис db)
USE_SQLITE=0
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=opora
POSTGRES_USER=opora_user
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=opora
# Спецсимволы в пароле в DATABASE_URL URL-кодируйте (напр. ! → %21).
# В Docker Compose хост db подставляется через DB_HOST — пароль берётся из POSTGRES_*.
DATABASE_URL=postgresql://opora_user:change-me@db:5432/opora

# Локальный запуск Python БЕЗ Docker (Postgres на localhost):
# POSTGRES_HOST=localhost
# DATABASE_URL=postgresql://opora_user:change-me@localhost:5432/opora

# Application
APP_NAME=Опора
APP_VERSION=0.1.0

# Адресные подсказки (серверный Nominatim)
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Укажите реальный контакт/домен приложения согласно политике Nominatim.
NOMINATIM_USER_AGENT=OPORA-address/0.1 (admin@example.com)
# Ограничивающий прямоугольник Кировской области: запад, север, восток, юг.
NOMINATIM_VIEWBOX=41.17,61.07,53.92,56.03
GEOCODING_TIMEOUT_SECONDS=2.5
GEOCODING_CACHE_TTL_SECONDS=600
GEOCODING_CACHE_MAX_SIZE=512
NOMINATIM_RATE_LIMIT_SECONDS=1.0
ADDRESS_SUGGESTION_LIMIT=8
ADDRESS_SELECTION_TOKEN_MAX_AGE=3600

# Security (за HTTPS на сервере поставьте True)
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# Admin (initial seed user)
ADMIN_EMAIL=admin@opora.ru
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Администратор системы

# Производительность (опционально)
# WEB_CONCURRENCY=3
# GUNICORN_THREADS=4
# DB_POOL_SIZE=8
# DB_MAX_OVERFLOW=16
# MESSENGER_UNREAD_INTERVAL_MS=45000
# MESSENGER_USER_LOOKUP_LIMIT=50
# PERFORMANCE_PROFILER_ENABLED=False
# PERFORMANCE_PROFILER_LOG_ALL=False
# PERFORMANCE_PROFILER_RESPONSE_HEADERS=False
# PERFORMANCE_SLOW_REQUEST_MS=500
# PERFORMANCE_SLOW_QUERY_MS=100
# PERFORMANCE_QUERY_COUNT_WARNING=30
