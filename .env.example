# Flask
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-random-secret-key

# Database
# Временный локальный режим без PostgreSQL:
# USE_SQLITE=1
# (файл instance/opora.db; схема через: python -m flask init-db)

# PostgreSQL (основной режим)
USE_SQLITE=0
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=opora
POSTGRES_USER=opora_user
POSTGRES_PASSWORD=change-me
POSTGRES_SCHEMA=opora
# Либо полный URL (спецсимволы в пароле URL-кодируйте, напр. ! → %21):
# DATABASE_URL=postgresql://opora_user:opora_password_2026%21@20.42.0.124:5432/opora
DATABASE_URL=postgresql://opora_user:change-me@localhost:5432/opora

# Application
APP_NAME=Опора
APP_VERSION=0.1.0

# Security
SESSION_COOKIE_SECURE=False
REMEMBER_COOKIE_SECURE=False

# Admin (initial seed user)
ADMIN_EMAIL=admin@opora.ru
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=Администратор системы
