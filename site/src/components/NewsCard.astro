---
import { Image } from 'astro:assets';
import type { NewsItem } from '../data/site';
import { newsImages } from '../lib/images';

interface Props {
  item: NewsItem;
  headingLevel?: 'h2' | 'h3';
}
const { item, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const date = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(item.date));
---

<article class="news-card">
  <div class="news-card__media media">
    <Image src={newsImages[item.image]} alt="" widths={[400, 640, 800]} sizes="(min-width: 1000px) 400px, (min-width: 700px) 45vw, 92vw" loading="lazy" />
  </div>
  <div class="news-card__body">
    <time datetime={item.date}>{date}</time>
    <H class="news-card__title"><a href={`/novosti/${item.slug}/`}>{item.title}</a></H>
    <p>{item.lead}</p>
  </div>
</article>

<style>
  .news-card { position: relative; background: var(--surface); border-radius: var(--r-xl); overflow: hidden; display: flex; flex-direction: column; transition: transform 0.25s; }
  .news-card:hover { transform: scale(1.01); }
  @media (prefers-reduced-motion: reduce) { .news-card:hover { transform: none; } }
  .news-card__media { aspect-ratio: 16 / 10; overflow: hidden; background: var(--night); }
  .news-card__media img { width: 100%; height: 100%; object-fit: cover; }
  .news-card__body { padding: 16px 20px 20px; }
  time { font-size: 0.8125rem; color: var(--muted); }
  .news-card__title { font-size: 1.125rem; margin: 4px 0 6px; line-height: 1.25; }
  .news-card__title a { color: var(--text); text-decoration: none; }
  .news-card__title a::after { content: ''; position: absolute; inset: 0; }
  .news-card:hover .news-card__title a { text-decoration: underline; }
  .news-card p { margin: 0; color: var(--muted); font-size: 0.9375rem; }
  :global(html[data-scheme]) .news-card { outline: 2px solid var(--fg); }
</style>
