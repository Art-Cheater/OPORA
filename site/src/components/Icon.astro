---
// Линейные иконки: толщина 2 px, скруглённые концы, сетка 24 px (брендбук).
// Общие иконки — по мотивам Feather (MIT), набор неисправностей нарисован для службы.
import { ICONS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
  [key: string]: unknown;
}



const { name, size = 24, label, class: cls, ...rest } = Astro.props;
const d = ICONS[name];
---

<svg
  {...rest}
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={d}></path>
</svg>
