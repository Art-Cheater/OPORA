---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import NewsCard from '../../components/NewsCard.astro';
import { NEWS, type NewsItem } from '../../data/site';
import { newsImages } from '../../lib/images';

export function getStaticPaths() {
  return NEWS.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props as { item: NewsItem };
const date = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(item.date));
const more = NEWS.filter((n) => n.slug !== item.slug).slice(0, 2);
---

<Base title={item.title} description={item.lead}>
  <article class="article">
    <div class="wrap article__wrap">
      <a class="link-arrow back" href="/novosti/"><Icon name="arrow-left" /> Все новости</a>
      <time datetime={item.date}>{date}</time>
      <h1>{item.title}</h1>
      <p class="lead">{item.lead}</p>
      <div class="article__media media">
        <Image src={newsImages[item.image]} alt="" widths={[800, 1200, 1600]} sizes="(min-width: 900px) 820px, 92vw" loading="eager" />
      </div>
      <div class="article__body">
        {item.body.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </article>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Ещё новости</h2>
      <div class="grid grid--2">
        {more.map((n) => <NewsCard item={n} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .article { padding: 40px 0 24px; }
  .article__wrap { max-width: 868px; }
  .back { margin-bottom: 24px; }
  time { display: block; color: var(--muted); font-size: 0.9375rem; margin-bottom: 8px; }
  .article__media { margin: 28px 0; border-radius: var(--r-lg); overflow: hidden; aspect-ratio: 3 / 2; background: var(--night); }
  .article__media img { width: 100%; height: 100%; object-fit: cover; }
  .article__body { font-size: 1.125rem; max-width: 40rem; }
</style>
