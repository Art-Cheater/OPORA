---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
---

<Base title="Где не горит уличный свет" description="Где в Кирове сейчас не горит уличный свет: карта открытых заявок Кировсвета, только адрес и статус.">
  <PageHero
    compact
    eyebrow="Карта работ"
    title="Где сейчас нет света"
    lead="Невыполненные заявки из службы. На карте только адрес и статус — имя, телефон и текст обращения не публикуются."
  />

  <section class="section section--tight">
    <div class="wrap">
      <div class="map map--big" data-map role="region" aria-label="Карта открытых заявок. Тот же список — ниже."></div>
      <p class="small note" data-map-note>Загружаем заявки…</p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2>Списком</h2>
      <ul class="open-list" data-open-list></ul>
    </div>
  </section>
</Base>

<script>
  import { createMap, addMarker } from '../../lib/map';
  import { escapeHtml, loadPublicRequests } from '../../scripts/public-requests';

  const note = document.querySelector('[data-map-note]')!;
  const list = document.querySelector('[data-open-list]')!;
  const el = document.querySelector<HTMLElement>('[data-map]')!;
  const { L, map } = await createMap(el, { zoom: 12, scrollWheel: true });

  try {
    const items = await loadPublicRequests();
    const points = items.filter((item) => item.lat != null && item.lon != null);
    note.textContent = points.length === items.length
      ? `Открытых заявок: ${items.length}. Контакты заявителей на карту не попадают.`
      : `Открытых заявок: ${items.length}. На карте ${points.length}: у остальных ещё нет точки.`;
    list.innerHTML = items.length
      ? items.map((item) => `<li>${escapeHtml(item.address)}${item.district ? ` · ${escapeHtml(item.district)}` : ''} — <b>${escapeHtml(item.status)}</b></li>`).join('')
      : '<li>Сейчас нет открытых заявок.</li>';
    for (const item of points) {
      const kind = /авар/i.test(item.status) ? 'alarm' : 'ticket';
      addMarker(L, map, item.lat!, item.lon!, kind, `<b>${escapeHtml(item.address)}</b><br>${escapeHtml(item.status)}`);
    }
    if (points.length) map.fitBounds(L.latLngBounds(points.map((item) => [item.lat!, item.lon!])), { padding: [30, 30], maxZoom: 14 });
  } catch {
    note.textContent = 'Заявки сейчас не загрузились. Позвоните диспетчеру.';
    list.innerHTML = '';
  }
</script>

<style>
  .map--big { height: 62vh; min-height: 380px; max-height: 640px; }
  .note { color: var(--muted); margin-top: 10px; }
  .open-list { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
</style>
