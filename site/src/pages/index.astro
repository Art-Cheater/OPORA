---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HomeBento from '../components/HomeBento.astro';
import Steps from '../components/Steps.astro';
import IncidentList from '../components/IncidentList.astro';
import NewsCard from '../components/NewsCard.astro';
import { CONTACTS, NEWS, SITE } from '../data/site';

const d = CONTACTS.dispatcher;
---

<Base title={SITE.name} headerCta="ghost" mobileBar="after-hero">
  <section class="top">
    <div class="wrap top__grid">
      <h1 class="top__title reveal" style="--d:0">Не горит фонарь?<br /><span>Сообщите&nbsp;— мы приедем.</span></h1>
      <div class="top__side reveal" style="--d:1">
        <p>Заявка за минуту, без регистрации. Диспетчер на связи круглосуточно: <a class="num" data-ks-phone="dispatcher" href={`tel:${d.tel}`}>{d.phone}</a></p>
        <a class="btn btn--primary btn--lg" href="/soobshit/" data-hero-cta>Сообщить о неисправности</a>
      </div>
    </div>
  </section>

  <section class="wrap reveal" style="--d:2" aria-label="Главное">
    <HomeBento />
  </section>

  <section class="section" aria-labelledby="incidents-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="incidents-title">Где сейчас нет света</h2>
          <p>Открытые заявки службы. Если ваш адрес уже в списке, повторно сообщать не нужно.</p>
        </div>
        <a class="link-arrow" href="/karta/">На карте <Icon name="arrow-right" /></a>
      </div>
      <IncidentList items={[]} />
    </div>
  </section>

  <section class="section section--flush" aria-labelledby="steps-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="steps-title">Как отправить заявку</h2>
          <p>Три шага, около минуты.</p>
        </div>
        <a class="link-arrow" href="/soobshit/">Начать <Icon name="arrow-right" /></a>
      </div>
      <Steps />
    </div>
  </section>

  <section class="section" aria-labelledby="news-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="news-title">Новости</h2>
        <a class="link-arrow" href="/novosti/">Все новости <Icon name="arrow-right" /></a>
      </div>
      <div class="grid grid--3" data-ks-news="home">
        {NEWS.slice(0, 3).map((n) => <NewsCard item={n} />)}
      </div>
    </div>
  </section>
</Base>

<script>
  import { iconSvg } from '../lib/icons';
  import { escapeHtml, loadPublicRequests, pluralRequests } from '../scripts/public-requests';

  const list = document.querySelector('[data-incidents]');
  const count = document.querySelector('[data-open-count]');
  const label = document.querySelector('[data-open-label]');
  if (list) list.innerHTML = `<li class="incident"><p class="incident__what">Загружаем открытые заявки…</p></li>`;
  loadPublicRequests().then((items) => {
    if (count) count.textContent = String(items.length);
    if (label) label.textContent = pluralRequests(items.length).replace(/^\d+\s/, '');
    if (!list) return;
    list.innerHTML = items.length
      ? items.map((item) => `
        <li class="incident incident--fault">
          <span class="icon-dot incident__icon" aria-hidden="true">${iconSvg('bolt')}</span>
          <div class="incident__body">
            <h3 class="incident__addr">${escapeHtml(item.address)}</h3>
            ${item.district ? `<p class="incident__what">${escapeHtml(item.district)}</p>` : ''}
          </div>
          <span class="chip chip--working incident__chip">${escapeHtml(item.status)}</span>
        </li>`).join('')
      : `<li class="incident"><p class="incident__what">Сейчас нет открытых заявок с адресом.</p></li>`;
  }).catch(() => {
    if (list) list.innerHTML = `<li class="incident"><p class="incident__what">Список заявок сейчас не загрузился. Карта по адресу «На карте» или звонок диспетчеру.</p></li>`;
  });
</script>

<style>
  .top { padding: 40px 0 24px; }
  @media (min-width: 900px) { .top { padding: 56px 0 28px; } }
  .top__grid { display: grid; gap: 20px; align-items: end; }
  @media (min-width: 900px) { .top__grid { grid-template-columns: 1.4fr 1fr; gap: 40px; } }
  .top__title { margin: 0; font-size: clamp(2.125rem, 1.4rem + 3vw, 3.5rem); line-height: 1.04; }
  .top__title span { color: var(--muted); }
  .top__side { display: grid; gap: 16px; justify-items: start; }
  .top__side p { margin: 0; color: var(--muted); font-size: 1.0625rem; max-width: 26rem; }
  .top__side a:not(.btn) { color: var(--text); font-weight: 600; white-space: nowrap; }
  @media (max-width: 520px) { .top__side .btn { width: 100%; } }
  .section--flush { padding-top: 0; }
</style>
