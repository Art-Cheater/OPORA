    background: radial-gradient(40% 35% at 25% 30%, rgba(255, 184, 28, 0.35), transparent 70%),
      radial-gradient(35% 30% at 75% 20%, rgba(61, 90, 128, 0.7), transparent 70%),
      radial-gradient(30% 30% at 55% 60%, rgba(120, 80, 200, 0.25), transparent 70%);
  }
  .vb-city { position: absolute; top: 0; left: 0; width: 100%; height: 100vh; object-fit: cover; z-index: -2; opacity: 0.28;
    mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 55%, transparent 90%); -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 30%, #000 55%, transparent 90%); }
  .glass { background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); backdrop-filter: blur(18px) saturate(1.4); -webkit-backdrop-filter: blur(18px) saturate(1.4); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 20px 50px -20px rgba(0, 0, 0, 0.6); }
