  @media (max-width: 899px) { .vb-nav { display: none; } .vb-pill { justify-content: space-between; } .vb-panel { grid-template-columns: 1fr; } .vb-panel__cell + .vb-panel__cell { border-left: 0; border-top: 1px solid rgba(255, 255, 255, 0.1); } }

  /* =============== C · Bento =============== */
