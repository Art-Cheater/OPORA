  .vb-nav a:hover { color: #fff; }
  .vb-btn { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 18px; border-radius: 999px; font-weight: 600; font-size: 14px; text-decoration: none; border: 0; }
  .vb-btn--y { background: #ffb81c; color: #14213d; box-shadow: 0 0 0 1px rgba(255, 184, 28, 0.5), 0 10px 30px -8px rgba(255, 184, 28, 0.6); }
  .vb-btn--y:hover { background: #ffc53d; }
  .vb-btn--glass { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.16); color: #fff; }
  .vb-btn--lg { height: 50px; padding: 0 24px; font-size: 15px; }
  .vb-hero { max-width: 900px; margin: 0 auto; padding: 96px 24px 64px; text-align: center; }
  .vb-tag { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; color: #c8d0e0; padding: 6px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.12); }
  .vb-live { width: 8px; height: 8px; border-radius: 50%; background: #4cc795; box-shadow: 0 0 12px #4cc795; }
  .vb h1 { font-size: clamp(40px, 6vw, 72px); font-weight: 700; letter-spacing: -0.045em; line-height: 1.02; margin: 24px 0 20px; }
  .vb-grad { background: linear-gradient(90deg, #ffd27a 0%, #ffb81c 40%, #fff 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .vb-sub { color: #aab4c8; font-size: 17px; max-width: 520px; margin: 0 auto 32px; }
  .vb-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .vb-panel { position: relative; margin: 56px auto 0; max-width: 760px; border-radius: 24px; display: grid; grid-template-columns: repeat(3, 1fr); text-align: left; padding: 8px 8px 28px; }
  .vb-panel__cell { padding: 18px 20px; display: grid; }
  .vb-panel__cell + .vb-panel__cell { border-left: 1px solid rgba(255, 255, 255, 0.1); }
  .vb-panel__cell span { font-size: 12px; color: #8c97ad; }
