  .vc-big { font-family: Montserrat; font-size: 52px; font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .vc-lights { display: flex; justify-content: space-between; }
  .vc-lights i { width: 6px; height: 6px; border-radius: 50%; background: #ffb81c; box-shadow: 0 0 8px rgba(255, 184, 28, 0.8); }
  .vc-check { display: flex; margin-top: auto; background: #f5f5f7; border-radius: 14px; padding: 4px; }
  .vc-check input { flex: 1; min-width: 0; border: 0; background: transparent; padding: 0 12px; font: 600 20px Montserrat; height: 44px; color: #1d1d1f; }
  .vc-check button { width: 44px; height: 44px; border: 0; border-radius: 11px; background: #1d1d1f; color: #fff; display: grid; place-items: center; cursor: pointer; }
