  .vb-lights { position: absolute; left: 28px; right: 28px; bottom: 14px; display: flex; justify-content: space-between; }
  .vb-lights i { width: 5px; height: 5px; border-radius: 50%; background: #ffb81c; opacity: 0.25; }
  @media (prefers-reduced-motion: no-preference) {
    .vb-lights i { animation: vb-on 3.6s ease-in-out infinite; animation-delay: calc(var(--i) * 120ms); }
    @keyframes vb-on { 0%, 100% { opacity: 0.25; box-shadow: none; } 40%, 60% { opacity: 1; box-shadow: 0 0 10px #ffb81c; } }
  }
  .vb-w { max-width: 1100px; margin: 0 auto; padding: 0 24px; }
