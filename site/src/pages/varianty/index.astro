---
// Сравнение дизайн-направлений (служебная страница, не индексируется).
// Стили из ui-ux-pro-max: A — Minimalism & Swiss, B — Glassmorphism/Spatial на тёмном, C — Bento Box Grid, D — Neo-brutalism.
import '@fontsource/montserrat/500.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/golos-text/400.css';
import '@fontsource/golos-text/500.css';
import '@fontsource/golos-text/600.css';
import { Image } from 'astro:assets';
import Icon from '../../components/Icon.astro';
import { CONTACTS, INCIDENTS, formatEta } from '../../data/site';
import { kirovToday, schedule, fmtTime, fmtDay } from '../../lib/sun';
import logoLight from '../../assets/img/logo-horizontal-t.png';
import logoDark from '../../assets/img/logo-horizontal-dark-t.png';
import heroWide from '../../assets/img/hero-desktop.jpg';
import heroTall from '../../assets/img/hero-mobile.jpg';
import crew from '../../assets/img/about-crew.jpg';
import aerial from '../../assets/img/aerial-lines.jpg';
import ownerYard from '../../assets/img/owner-yard.png';
import ownerStreet from '../../assets/img/owner-street.png';

const d = CONTACTS.dispatcher;
const { y, m, d: day } = kirovToday();
const [today] = schedule(y, m, day, 1);
const ON = fmtTime(today.on);
const OFF = fmtTime(today.off);
const DAY = fmtDay(today.date);
const NAV = ['Карта работ', 'График', 'Чей фонарь', 'Вопросы', 'Контакты'];
const INC = INCIDENTS.slice(0, 3);
const TASKS = [
  { t: 'Сообщить о неисправности', s: 'Заявка за минуту, без регистрации', i: 'lamp-off' },
  { t: 'Проверить заявку', s: 'Статус по номеру КС-26-…', i: 'search' },
  { t: 'Где сейчас нет света', s: `${INCIDENTS.length} адреса с работами`, i: 'map' },
  { t: 'Когда включат свет', s: `Сегодня в ${ON}`, i: 'clock' },
  { t: 'Чей это фонарь', s: 'Улица, двор или светофор', i: 'users' },
] as const;
const VARIANTS = [
  { id: 'a', name: 'Минимализм' },
  { id: 'b', name: 'Ночное стекло' },
  { id: 'c', name: 'Бенто' },
  { id: 'd', name: 'Необрутализм' },
];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Варианты дизайна — Кировсвет</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <!-- ================= A · Швейцарский минимализм ================= -->
    <section class="variant va" data-variant="a">
      <header class="va-h">
        <div class="va-w va-h__in">
          <Image src={logoLight} alt="Кировсвет" height={30} width={Math.round((logoLight.width / logoLight.height) * 30)} densities={[1, 2]} />
          <nav class="va-nav" aria-label="Меню варианта A">{NAV.map((n) => <a href="#">{n}</a>)}</nav>
          <div class="va-h__r">
            <a class="va-phone num" href={`tel:${d.tel}`}>{d.phone}</a>
            <a class="va-btn va-btn--y" href="/soobshit/">Сообщить</a>
          </div>
        </div>
      </header>
      <div class="va-w va-hero">
        <div class="va-hero__txt">
          <p class="va-kick"><span class="num">01</span> Служба наружного освещения Кирова</p>
          <h1>Не горит фонарь? Сообщите&nbsp;— мы&nbsp;приедем.</h1>
          <p class="va-sub">Заявка за минуту, без регистрации. Отметьте место на карте, приложите фото, следите за ремонтом по номеру.</p>
          <div class="va-actions">
            <a class="va-btn va-btn--y va-btn--lg" href="/soobshit/">Сообщить о неисправности <Icon name="arrow-right" size={18} /></a>
            <a class="va-btn va-btn--ghost va-btn--lg" href="/zayavka/">Проверить заявку</a>
          </div>
        </div>
        <figure class="va-fig">
          <Image src={heroTall} alt="" widths={[480, 800]} sizes="420px" />
          <figcaption><span class="num">58.60° N, 49.67° E</span> — Киров, вечер. Свет включился в {ON}.</figcaption>
        </figure>
      </div>
      <div class="va-w">
        <dl class="va-facts">
          <div><dt>Включение сегодня</dt><dd class="num">{ON}</dd></div>
          <div><dt>Отключение утром</dt><dd class="num">{OFF}</dd></div>
          <div><dt>Заявок в работе</dt><dd class="num">37</dd></div>
          <div><dt>Выполнено в срок</dt><dd class="num">94%</dd></div>
        </dl>
      </div>
      <section class="va-w va-sec">
        <header class="va-sec__h"><span class="num">02</span><h2>Что вы хотите сделать</h2></header>
        <ol class="va-rows">
          {TASKS.map((t, i) => (
            <li><a href="#"><span class="num va-rows__n">0{i + 1}</span><b>{t.t}</b><span class="va-rows__s">{t.s}</span><Icon name="arrow-right" size={20} /></a></li>
          ))}
        </ol>
      </section>
      <section class="va-w va-sec">
        <header class="va-sec__h"><span class="num">03</span><h2>Где сейчас нет света</h2></header>
        <div class="va-table">
          {INC.map((i) => (
            <div class="va-tr"><b>{i.address}</b><span>{i.what}</span><span class="va-st">{i.status}</span><span class="num">{formatEta(i)}</span></div>
          ))}
        </div>
      </section>
      <footer class="va-f"><div class="va-w va-f__in"><span>© Кировсвет</span><span>Светло в каждом квартале</span><a class="num" href={`tel:${d.tel}`}>{d.phone}</a></div></footer>
    </section>

    <!-- ================= B · Ночное стекло ================= -->
    <section class="variant vb" data-variant="b" hidden>
      <div class="vb-aurora" aria-hidden="true"></div>
      <Image class="vb-city" src={heroWide} alt="" widths={[1280, 1920]} sizes="100vw" />
      <header class="vb-h">
        <div class="vb-pill">
          <Image src={logoDark} alt="Кировсвет" height={28} width={Math.round((logoDark.width / logoDark.height) * 28)} densities={[1, 2]} />
          <nav class="vb-nav" aria-label="Меню варианта B">{NAV.map((n) => <a href="#">{n}</a>)}</nav>
          <a class="vb-btn vb-btn--y" href="/soobshit/">Сообщить</a>
        </div>
      </header>
      <div class="vb-hero">
        <p class="vb-tag"><span class="vb-live"></span> Диспетчер на связи · 24/7</p>
        <h1>Не горит фонарь?<br /><span class="vb-grad">Сообщите — мы приедем</span></h1>
        <p class="vb-sub">Заявка за минуту, без регистрации. Метка на карте, фото, статус ремонта по номеру.</p>
        <div class="vb-actions">
          <a class="vb-btn vb-btn--y vb-btn--lg" href="/soobshit/">Сообщить о неисправности</a>
          <a class="vb-btn vb-btn--glass vb-btn--lg" href={`tel:${d.tel}`}><Icon name="phone" size={18} /> {d.phone}</a>
        </div>
        <div class="vb-panel glass">
          <div class="vb-panel__cell"><span>Сегодня, {DAY}</span><strong class="num">{ON}</strong><em>включение</em></div>
          <div class="vb-panel__cell"><span>Утром</span><strong class="num">{OFF}</strong><em>отключение</em></div>
          <div class="vb-panel__cell"><span>Сейчас</span><strong class="num">37</strong><em>заявок в работе</em></div>
          <div class="vb-lights" aria-hidden="true">{Array.from({ length: 18 }, (_, i) => <i style={`--i:${i}`}></i>)}</div>
        </div>
      </div>
      <section class="vb-w vb-bento">
        <div class="glass vb-card vb-card--wide">
          <span class="vb-ico"><Icon name="search" /></span>
          <h3>Проверить заявку</h3>
          <form class="vb-check" action="/zayavka/"><input type="text" name="n" inputmode="numeric" placeholder="Номер, например 004812" aria-label="Номер заявки" /><button type="submit">Проверить</button></form>
        </div>
        <a class="glass vb-card vb-card--map" href="#">
          <Image class="vb-card__bg" src={aerial} alt="" widths={[640]} sizes="400px" />
          <span class="vb-ico"><Icon name="map" /></span>
          <h3>Где нет света</h3><p>{INCIDENTS.length} адреса с работами</p>
        </a>
        <a class="glass vb-card" href="#"><span class="vb-ico"><Icon name="clock" /></span><h3>Когда включат</h3><p>Сегодня в <b class="num">{ON}</b></p></a>
        <a class="glass vb-card" href="#"><span class="vb-ico"><Icon name="users" /></span><h3>Чей это фонарь</h3><p>Улица, двор или светофор</p></a>
        <a class="glass vb-card" href="#"><span class="vb-ico"><Icon name="info" /></span><h3>Частые вопросы</h3><p>Сроки ремонта, номер опоры</p></a>
        <a class="glass vb-card vb-card--wide vb-card--art" href="#">
          <Image class="vb-card__art" src={ownerStreet} alt="" widths={[480]} sizes="260px" />
          <span class="vb-ico"><Icon name="lamp-on" /></span><h3>Попросить новый фонарь</h3><p>Как улица попадает в план строительства</p>
        </a>
      </section>
      <section class="vb-w vb-sec">
        <h2>Где сейчас нет света</h2>
        <div class="glass vb-list">
          {INC.map((i) => (
            <div class="vb-row"><span class="vb-dot"></span><div><b>{i.address}</b><span>{i.what}</span></div><span class="vb-chip">{i.status}</span><span class="num vb-eta">{formatEta(i)}</span></div>
          ))}
        </div>
      </section>
      <footer class="vb-f"><span>© Кировсвет · Светло в каждом квартале</span><a class="num" href={`tel:${d.tel}`}>{d.phone}</a></footer>
    </section>

    <!-- ================= C · Бенто ================= -->
    <section class="variant vc" data-variant="c" hidden>
      <header class="vc-h">
        <div class="vc-w vc-h__in">
          <Image src={logoLight} alt="Кировсвет" height={28} width={Math.round((logoLight.width / logoLight.height) * 28)} densities={[1, 2]} />
          <nav class="vc-nav" aria-label="Меню варианта C">{NAV.map((n) => <a href="#">{n}</a>)}</nav>
          <a class="vc-btn vc-btn--y" href="/soobshit/">Сообщить</a>
        </div>
      </header>
      <div class="vc-w vc-top">
        <h1>Не горит фонарь?<br /><span>Сообщите — мы приедем.</span></h1>
        <div class="vc-top__r">
          <p>Заявка за минуту, без регистрации. Диспетчер — круглосуточно.</p>
          <a class="vc-btn vc-btn--y vc-btn--lg" href="/soobshit/">Сообщить о неисправности</a>
        </div>
      </div>
      <div class="vc-w vc-bento">
        <a class="vc-tile vc-tile--hero" href="/soobshit/">
          <Image src={heroWide} alt="" widths={[800, 1280]} sizes="(min-width: 900px) 640px, 92vw" />
          <div class="vc-tile__over"><span class="vc-badge">Без регистрации</span><h3>Отметьте место — бригада приедет</h3><span class="vc-link">Начать <Icon name="arrow-right" size={16} /></span></div>
        </a>
        <div class="vc-tile vc-tile--night">
          <span class="vc-cap">Сегодня, {DAY}</span>
          <strong class="num vc-big">{ON}</strong><span class="vc-cap">включение · отключение в <b class="num">{OFF}</b></span>
          <div class="vc-lights" aria-hidden="true">{Array.from({ length: 10 }, () => <i></i>)}</div>
        </div>
        <div class="vc-tile">
          <span class="vc-cap">Проверить заявку</span>
          <form class="vc-check" action="/zayavka/"><input type="text" name="n" inputmode="numeric" placeholder="004812" aria-label="Номер заявки" /><button type="submit" aria-label="Проверить"><Icon name="arrow-right" size={18} /></button></form>
          <span class="vc-hint">Достаточно цифр из номера</span>
        </div>
        <a class="vc-tile vc-tile--map" href="#">
          <Image src={aerial} alt="" widths={[640]} sizes="320px" />
          <div class="vc-tile__over vc-tile__over--dark"><strong class="num vc-big">{INCIDENTS.length}</strong><span>адреса без света сейчас</span></div>
        </a>
        <a class="vc-tile vc-tile--art" href="#">
          <span class="vc-cap">Чей это фонарь</span><h3>Двор — это УК</h3>
          <Image src={ownerYard} alt="" widths={[360]} sizes="220px" />
        </a>
        <div class="vc-tile vc-tile--stats">
          <div><strong class="num">94%</strong><span>заявок выполнено в срок</span></div>
          <div><strong class="num">1,9 дня</strong><span>средний ремонт фонаря</span></div>
          <div><strong class="num">31 400</strong><span>светильников в городе</span></div>
        </div>
        <a class="vc-tile vc-tile--photo" href="#">
          <Image src={crew} alt="" widths={[640]} sizes="420px" />
          <div class="vc-tile__over"><h3>9 бригад на связи</h3></div>
        </a>
      </div>
      <section class="vc-w vc-sec">
        <h2>Где сейчас нет света</h2>
        <div class="vc-list">
          {INC.map((i) => (
            <div class="vc-row"><div><b>{i.address}</b><span>{i.what}</span></div><span class="vc-chip">{i.status}</span><span class="num">{formatEta(i)}</span></div>
          ))}
        </div>
      </section>
      <footer class="vc-f"><div class="vc-w vc-f__in"><span>© Кировсвет</span><a class="num" href={`tel:${d.tel}`}>{d.phone}</a></div></footer>
    </section>

    <!-- ================= D · Необрутализм ================= -->
    <section class="variant vd" data-variant="d" hidden>
      <header class="vd-h">
        <div class="vd-w vd-h__in">
          <Image src={logoLight} alt="Кировсвет" height={30} width={Math.round((logoLight.width / logoLight.height) * 30)} densities={[1, 2]} />
          <nav class="vd-nav" aria-label="Меню варианта D">{NAV.map((n) => <a href="#">{n}</a>)}</nav>
          <a class="vd-btn vd-btn--y" href="/soobshit/">Сообщить</a>
        </div>
      </header>
      <div class="vd-w vd-hero">
        <div>
          <span class="vd-sticker">Киров · 24/7</span>
          <h1>Не горит фонарь? <mark>Сообщите</mark> — мы приедем</h1>
          <p class="vd-sub">Заявка за минуту, без регистрации. С фото, меткой на карте и номером, по которому видно ремонт.</p>
          <div class="vd-actions">
            <a class="vd-btn vd-btn--y vd-btn--lg" href="/soobshit/">Сообщить о неисправности <Icon name="arrow-right" size={18} /></a>
            <a class="vd-btn vd-btn--lg" href={`tel:${d.tel}`}><Icon name="phone" size={18} /> {d.phone}</a>
          </div>
        </div>
        <div class="vd-photo">
          <Image src={heroTall} alt="" widths={[480, 800]} sizes="400px" />
          <span class="vd-stamp">Светло в каждом квартале</span>
          <div class="vd-today"><span>Сегодня</span><strong class="num">{ON}</strong><span>включение</span></div>
        </div>
      </div>
      <div class="vd-strip" aria-hidden="true"><span>Не горит</span>✦<span>Мигает</span>✦<span>Горит днём</span>✦<span>Оборван провод</span>✦<span>Наклонилась опора</span>✦<span>Открыт щит</span></div>
      <section class="vd-w vd-sec">
        <h2>Что нужно сделать?</h2>
        <div class="vd-cards">
          {TASKS.slice(1).map((t, i) => (
            <a class:list={['vd-card', `vd-card--${i}`]} href="#"><Icon name={t.i} size={28} /><h3>{t.t}</h3><p>{t.s}</p><span class="vd-go"><Icon name="arrow-right" size={20} /></span></a>
          ))}
        </div>
      </section>
      <section class="vd-w vd-sec">
        <h2>Где сейчас нет света</h2>
        <div class="vd-list">
          {INC.map((i) => (
            <div class="vd-row"><div><b>{i.address}</b><span>{i.what}</span></div><span class="vd-chip">{i.status}</span><span class="num vd-eta">{formatEta(i)}</span></div>
          ))}
        </div>
      </section>
      <footer class="vd-f"><div class="vd-w vd-f__in"><span>© Кировсвет</span><a class="num" href={`tel:${d.tel}`}>{d.phone}</a></div></footer>
    </section>

    <!-- Переключатель вариантов -->
    <nav class="switch" aria-label="Варианты дизайна">
      {VARIANTS.map((v) => <button type="button" data-show={v.id} aria-pressed={v.id === 'a' ? 'true' : 'false'}><b>{v.id.toUpperCase()}</b> {v.name}</button>)}
    </nav>

    <script>
      const show = (id: string) => {
        document.querySelectorAll<HTMLElement>('[data-variant]').forEach((s) => (s.hidden = s.dataset.variant !== id));
        document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.show === id)));
        history.replaceState(null, '', `#${id}`);
        window.scrollTo(0, 0);
      };
      document.querySelectorAll<HTMLButtonElement>('[data-show]').forEach((b) => b.addEventListener('click', () => show(b.dataset.show!)));
      const initial = location.hash.slice(1);
      if (['a', 'b', 'c', 'd'].includes(initial)) show(initial);
      document.querySelectorAll('.variant a[href="#"]').forEach((a) => a.addEventListener('click', (e) => e.preventDefault()));
    </script>
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  [hidden] { display: none !important; }
  body { margin: 0; font-family: 'Golos Text', system-ui, sans-serif; font-size: 16px; line-height: 1.55; -webkit-font-smoothing: antialiased; }
  img { display: block; max-width: 100%; height: auto; }
  h1, h2, h3 { margin: 0; font-family: Montserrat, sans-serif; text-wrap: balance; }
  p { margin: 0; }
  .num { font-variant-numeric: tabular-nums; }
  a { color: inherit; }
  :focus-visible { outline: 3px solid #ffb81c; outline-offset: 3px; border-radius: 4px; }

  .switch {
    position: fixed; left: 50%; bottom: 20px; transform: translateX(-50%); z-index: 100; display: flex; gap: 4px; padding: 6px;
    background: rgba(20, 20, 24, 0.86); backdrop-filter: blur(16px); border-radius: 999px; box-shadow: 0 12px 40px -10px rgba(0, 0, 0, 0.5);
    max-width: calc(100vw - 24px); overflow-x: auto;
  }
  .switch button {
    border: 0; background: transparent; color: #c9ccd4; padding: 10px 16px; border-radius: 999px; font: 500 14px 'Golos Text', sans-serif; cursor: pointer; white-space: nowrap;
  }
  .switch button b { color: #ffb81c; margin-right: 4px; }
  .switch button[aria-pressed='true'] { background: #fff; color: #14213d; }
  .variant { min-height: 100vh; padding-bottom: 96px; }

  /* =============== A · Swiss =============== */
  .va { background: #fff; color: #0b1220; }
  .va-w { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .va-h { border-bottom: 1px solid #e8eaee; position: sticky; top: 0; background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); z-index: 10; }
  .va-h__in { display: flex; align-items: center; gap: 32px; height: 64px; }
  .va-h__in img { height: 30px; width: auto; }
  .va-nav { display: flex; gap: 24px; font-size: 14px; color: #5c6475; }
  .va-nav a { text-decoration: none; }
  .va-nav a:hover { color: #0b1220; }
  .va-h__r { margin-left: auto; display: flex; align-items: center; gap: 20px; font-size: 14px; }
  .va-phone { text-decoration: none; font-weight: 600; }
  .va-btn { display: inline-flex; align-items: center; gap: 8px; height: 40px; padding: 0 16px; border-radius: 6px; font-weight: 600; font-size: 14px; text-decoration: none; border: 1px solid #0b1220; }
  .va-btn--y { background: #ffb81c; border-color: #ffb81c; color: #0b1220; }
  .va-btn--y:hover { background: #ffc53d; }
  .va-btn--ghost:hover { background: #0b1220; color: #fff; }
  .va-btn--lg { height: 48px; padding: 0 22px; font-size: 15px; }
  .va-hero { display: grid; grid-template-columns: 1fr; gap: 48px; padding-top: 72px; padding-bottom: 56px; }
  @media (min-width: 900px) { .va-hero { grid-template-columns: 7fr 5fr; align-items: end; } }
  .va-kick { font-size: 13px; color: #5c6475; letter-spacing: 0.02em; margin-bottom: 28px; display: flex; gap: 12px; align-items: center; }
  .va-kick span { color: #0b1220; font-weight: 600; }
  .va-kick span::after { content: ''; display: inline-block; width: 32px; height: 1px; background: #0b1220; margin-left: 12px; vertical-align: middle; }
  .va h1 { font-size: clamp(40px, 5.2vw, 68px); font-weight: 600; letter-spacing: -0.045em; line-height: 1.02; }
  .va-sub { font-size: 17px; color: #5c6475; max-width: 480px; margin: 24px 0 32px; }
  .va-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .va-fig { margin: 0; }
  .va-fig img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 4px; filter: saturate(0.9); }
  .va-fig figcaption { font-size: 12px; color: #5c6475; margin-top: 10px; }
  .va-facts { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-top: 1px solid #0b1220; }
  @media (min-width: 800px) { .va-facts { grid-template-columns: repeat(4, 1fr); } }
