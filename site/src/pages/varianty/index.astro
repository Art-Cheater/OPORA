  @media (min-width: 800px) { .vb-bento { grid-template-columns: repeat(4, 1fr); } .vb-card--wide { grid-column: span 2; } }
  .vb-card { position: relative; overflow: hidden; border-radius: 22px; padding: 22px; min-height: 180px; display: flex; flex-direction: column; justify-content: flex-end; gap: 4px; text-decoration: none; color: #fff; transition: border-color 0.2s, transform 0.2s; }
  a.vb-card:hover { border-color: rgba(255, 184, 28, 0.5); transform: translateY(-2px); }
