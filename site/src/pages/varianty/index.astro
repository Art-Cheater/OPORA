  /* =============== D · Neo-brutalism =============== */
  .vd { background: #fbf6ea; color: #14213d; --bd: 2.5px solid #14213d; --sh: 5px 5px 0 #14213d; }
  .vd-w { max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  .vd-h { border-bottom: var(--bd); background: #fff; position: sticky; top: 0; z-index: 10; }
  .vd-h__in { display: flex; align-items: center; gap: 28px; height: 68px; }
  .vd-h__in img { height: 30px; width: auto; }
  .vd-nav { display: flex; gap: 20px; font-weight: 600; font-size: 14px; margin-right: auto; }
  .vd-nav a { text-decoration: none; }
  .vd-nav a:hover { text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: #ffb81c; }
  .vd-btn { display: inline-flex; align-items: center; gap: 8px; height: 42px; padding: 0 18px; border: var(--bd); border-radius: 12px; background: #fff; font-weight: 700; font-size: 14px; text-decoration: none; box-shadow: 3px 3px 0 #14213d; transition: transform 0.12s, box-shadow 0.12s; }
  .vd-btn:hover { transform: translate(-2px, -2px); box-shadow: 5px 5px 0 #14213d; }
  .vd-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #14213d; }
  .vd-btn--y { background: #ffb81c; }
  .vd-btn--lg { height: 52px; padding: 0 22px; font-size: 15px; }
  .vd-hero { display: grid; gap: 40px; padding-top: 56px; padding-bottom: 48px; align-items: center; }
  @media (min-width: 900px) { .vd-hero { grid-template-columns: 1.2fr 1fr; } }
  .vd-sticker { display: inline-block; transform: rotate(-3deg); background: #9fd6c2; border: var(--bd); border-radius: 10px; padding: 4px 12px; font-weight: 700; font-size: 13px; box-shadow: 3px 3px 0 #14213d; margin-bottom: 20px; }
  .vd h1 { font-size: clamp(40px, 5.4vw, 70px); font-weight: 800; letter-spacing: -0.045em; line-height: 1; }
  .vd mark { background: #ffb81c; color: inherit; padding: 0 8px; border: var(--bd); border-radius: 12px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .vd-sub { font-size: 17px; max-width: 480px; margin: 24px 0 28px; }
  .vd-actions { display: flex; gap: 14px; flex-wrap: wrap; }
  .vd-photo { position: relative; border: var(--bd); border-radius: 22px; box-shadow: 8px 8px 0 #14213d; overflow: visible; }
  .vd-photo img { width: 100%; aspect-ratio: 4 / 4.4; object-fit: cover; border-radius: 19px; }
  .vd-stamp { position: absolute; top: -18px; right: -14px; transform: rotate(6deg); background: #ffb81c; border: var(--bd); border-radius: 999px; padding: 10px 18px; font-weight: 800; font-size: 14px; box-shadow: var(--sh); }
  .vd-today { position: absolute; left: -18px; bottom: 24px; transform: rotate(-4deg); background: #fff; border: var(--bd); border-radius: 16px; padding: 10px 16px; box-shadow: var(--sh); display: grid; }
  .vd-today span { font-size: 12px; font-weight: 600; }
  .vd-today strong { font-family: Montserrat; font-size: 34px; font-weight: 800; line-height: 1; }
  .vd-strip { display: flex; gap: 22px; align-items: center; overflow: hidden; white-space: nowrap; background: #14213d; color: #ffb81c; border-block: var(--bd); padding: 14px 24px; font-family: Montserrat; font-weight: 800; font-size: 20px; }
  .vd-strip span { color: #fff; }
  .vd-sec { padding-top: 64px; }
  .vd-sec h2 { font-size: clamp(28px, 3vw, 38px); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 24px; }
  .vd-cards { display: grid; gap: 18px; }
  @media (min-width: 700px) { .vd-cards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .vd-cards { grid-template-columns: repeat(4, 1fr); } }
  .vd-card { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 22px; min-height: 190px; border: var(--bd); border-radius: 18px; box-shadow: var(--sh); text-decoration: none; transition: transform 0.12s, box-shadow 0.12s; }
  .vd-card:hover { transform: translate(-3px, -3px); box-shadow: 8px 8px 0 #14213d; }
  .vd-card h3 { font-size: 19px; font-weight: 800; margin-top: auto; }
  .vd-card p { font-size: 14px; }
  .vd-card--0 { background: #ffb81c; }
  .vd-card--1 { background: #fff; }
  .vd-card--2 { background: #c9dcf5; }
  .vd-card--3 { background: #9fd6c2; }
  .vd-go { position: absolute; top: 18px; right: 18px; width: 36px; height: 36px; border: var(--bd); border-radius: 50%; display: grid; place-items: center; background: #fff; }
  .vd-list { display: grid; gap: 12px; }
  .vd-row { display: grid; gap: 6px 16px; padding: 16px 20px; background: #fff; border: var(--bd); border-radius: 14px; font-size: 15px; }
  @media (min-width: 800px) { .vd-row { grid-template-columns: 1fr auto 200px; align-items: center; } .vd-eta { text-align: right; } }
  .vd-row div { display: grid; }
  .vd-row div span { font-size: 14px; color: #3d4a66; }
  .vd-chip { justify-self: start; font-size: 12px; font-weight: 800; padding: 4px 10px; border: 2px solid #14213d; border-radius: 999px; background: #ffb81c; }
