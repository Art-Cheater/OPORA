---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import OwnerCards from '../../components/OwnerCards.astro';
import Icon from '../../components/Icon.astro';
import { OWNER_TABLE, CONTACTS } from '../../data/site';
import isometric from '../../assets/img/chey-isometric.png';
---

<Base title="Чей фонарь: улица, двор или светофор" description="Не горит фонарь в Кирове: улицу и тротуар чинит Кировсвет, двор и подъезд — управляющая компания, светофор — через ЕДДС.">
  <PageHero
    compact
    eyebrow="Кто за что отвечает"
    title="Чей это фонарь"
    lead="С фонарём во дворе часто идут к нам, а это зона управляющей компании. Разберитесь за минуту — или просто отправьте заявку: если фонарь не наш, передадим и напишем кому."
  />

  <section class="section">
    <div class="wrap scheme">
      <div class="scheme__art">
        <Image src={isometric} alt="Схема квартала: улица с фонарями, двор с фонарями над подъездами и перекрёсток со светофорами" widths={[600, 900, 1200, 1800]} sizes="(min-width: 1000px) 560px, 92vw" loading="eager" />
      </div>
      <div>
        <h2>Три зоны ответственности</h2>
        <ol class="scheme__legend">
        <li><span class="badge">1</span><div><b>Улица и тротуар</b> — фонари на опорах вдоль дороги. Это мы, «Кировсвет».</div></li>
        <li><span class="badge">2</span><div><b>Двор и подъезды</b> — управляющая компания или ТСЖ вашего дома.</div></li>
        <li><span class="badge">3</span><div><b>Светофоры</b> — служба организации дорожного движения, через ЕДДС.</div></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <OwnerCards />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Кому звонить</h2>
      <div class="table-wrap">
        <table class="table table--stack" role="table">
          <thead role="rowgroup"><tr role="row"><th role="columnheader" scope="col">Где не горит</th><th role="columnheader" scope="col">Кто отвечает</th><th role="columnheader" scope="col">Куда обращаться</th></tr></thead>
          <tbody role="rowgroup">
            {OWNER_TABLE.map((r) => (
              <tr role="row" class:list={{ ours: r.who === 'Кировсвет' }}>
                <td role="cell" data-label="Где не горит">{r.place}</td>
                <td role="cell" data-label="Кто отвечает"><b>{r.who}</b></td>
                <td role="cell" data-label="Куда обращаться">{r.how}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section--tight" id="yard">
    <div class="wrap grid grid--2">
      <div class="card">
        <h2 class="h3">Как найти свою управляющую компанию</h2>
        <ol class="steps">
          <li>Посмотрите квитанцию за ЖКУ — название и телефон УК указаны в шапке.</li>
          <li>Найдите дом в ГИС ЖКХ на <a href="https://dom.gosuslugi.ru/" target="_blank" rel="noopener">dom.gosuslugi.ru</a> — там указана организация, которая управляет домом.</li>
          <li>Не нашли — отправьте заявку нам. Мы передадим её в УК и напишем, кому именно.</li>
        </ol>
        <a class="btn btn--night" href="/soobshit/"><Icon name="lamp-off" /> Отправить заявку</a>
      </div>
      <div class="card" id="traffic">
        <h2 class="h3">Светофоры, парки и трассы</h2>
        <p>Эти объекты обслуживают другие организации. Если не знаете кто — звоните в единую дежурно-диспетчерскую службу города: там соединят с нужной службой.</p>
        <p class="big-phone"><a class="num" data-ks-phone="edds" href={`tel:${CONTACTS.edds.tel}`}>{CONTACTS.edds.phone}</a> <span>{CONTACTS.edds.title}, круглосуточно</span></p>
        <p class="small muted">Опасная ситуация — оборван провод, искрит, горит — звоните 112.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .scheme { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 1000px) { .scheme { grid-template-columns: 1.2fr 1fr; } }
  .scheme__art { background: radial-gradient(90% 90% at 50% 60%, #1d2e52, var(--night) 72%); border-radius: var(--r-lg); padding: 24px; }
  .scheme__legend { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .scheme__legend li { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; font-size: 1.0625rem; }
  .badge { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: var(--sodium); color: var(--night); font-family: var(--font-head); font-weight: 700; }
  .scheme__legend li:nth-child(2) .badge { background: var(--dusk); color: #fff; }
  .scheme__legend li:nth-child(3) .badge { background: var(--asphalt); color: #fff; }
  .ours td { background: color-mix(in srgb, var(--sodium) 10%, transparent); }
  @media (max-width: 640px) { .ours { background: var(--sodium-soft); } .ours td { background: transparent; } }
  .h3 { font-size: 1.375rem; }
  .steps { padding-left: 20px; display: grid; gap: 8px; margin: 0 0 20px; }
  .big-phone a { font-family: var(--font-head); font-size: 2rem; font-weight: 700; color: var(--text); text-decoration: none; margin-right: 8px; }
  .big-phone span { color: var(--muted); }
  .muted { color: var(--muted); }
</style>
